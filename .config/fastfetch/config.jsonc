{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  › ",
    "color": {
      "separator": "bright_cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored} @ {host-name-colored}"
    },
    {
      "type": "custom",
      "format": "──────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 os  ",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "󰌽 ker ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󰅐 up  ",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "󰏖 pkg ",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "󱂬 wm  ",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "󰞷 term",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "󰍛 mem ",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
